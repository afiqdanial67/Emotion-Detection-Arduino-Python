bool isPlayingNote = false;
unsigned long noteStartTime = 0;
int currentNoteDuration = 0;

// LCD Initialization (I2C Address 0x27)
LiquidCrystal_I2C lcd(0x27, 16, 4);

int currentEmotion = 0; // 0: Standby, 1: Sad, 2: Happy, 3: Angry, 4: Tired
int currentSegment = 0; 

unsigned long previousMillis = 0;
const long segmentDuration = 3500; // 3.5 saat setiap segmen emosi

// Auto Scroll Standby (DHT vs Camera Status)
unsigned long standbyMillis = 0;
const long standbyInterval = 3000; // Tukar paparan setiap 3 saat semasa Standby
int standbyState = 0; 

void setup() {
  Serial.begin(9600); // Mesti 9600 mengikut baud_rate Python
  
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(LED_PIN, OUTPUT);
  pinMode(BUTTON_PIN, INPUT_PULLUP);

  dht.begin();
  lcd.init();
  lcd.backlight();
  
  displayStandby(0);
}

void loop() {
  // 1. SEMAK TEKANAN PUSH BUTTON
  checkPushButton();

  // 2. Terima input dari Serial (Python Camera)
  if (currentEmotion == 0 && Serial.available() > 0) {
    char incomingChar = Serial.read();
    
    if (incomingChar == '1')      selectEmotion(1); // SAD
    else if (incomingChar == '2') selectEmotion(2); // HAPPY
    else if (incomingChar == '3') selectEmotion(3); // ANGRY
    else if (incomingChar == '4') selectEmotion(4); // TIRED
  }

  // 3. AUTO-SCROLL PAPARAN STANDBY (Termasuk Suhu & Kelembapan)
  if (currentEmotion == 0) {
    unsigned long currentMillis = millis();
    if (currentMillis - standbyMillis >= standbyInterval) {
      standbyMillis = currentMillis;
      standbyState = (standbyState + 1) % 2; 
      displayStandby(standbyState);
    }
  }

  // 4. Logik Program Emosi & Auto-Scroll Segmen
  if (currentEmotion > 0) {
    unsigned long currentMillis = millis();

    bool isSongFinished = checkAndPlayMelody();

    if (isSongFinished) {
      resetToStandby();
      return;
    }

    if (currentMillis - previousMillis >= segmentDuration) {
      previousMillis = currentMillis;
      
      int startMotivasi = 0;
      int maxSegment = 0;

      if (currentEmotion == 1)      { startMotivasi = 4; maxSegment = 7; }
      else if (currentEmotion == 2) { startMotivasi = 3; maxSegment = 6; }
      else if (currentEmotion == 3) { startMotivasi = 3; maxSegment = 6; }
      else if (currentEmotion == 4) { startMotivasi = 4; maxSegment = 7; }

      currentSegment++;

      if (currentSegment < startMotivasi) {
        updateLCD();
      } 
      else if (currentSegment >= startMotivasi) {
        if (currentSegment >= maxSegment) {
          currentSegment = startMotivasi; 
        }
        updateLCD();
      }
    }
  }
}

void checkPushButton() {
  int reading = digitalRead(BUTTON_PIN);

  if (reading != lastButtonState) {
    lastDebounceTime = millis();
  }

  if ((millis() - lastDebounceTime) > debounceDelay) {
    static bool buttonState = HIGH;
    if (reading != buttonState) {
      buttonState = reading;
      if (buttonState == LOW) {
        // Hantar isyarat tepat ke Python untuk hidupkan/matikan imbasan
        Serial.println(F("TOGGLE_CAM"));
      }
    }
  }
  lastButtonState = reading;
}

bool checkAndPlayMelody() {
  bool isMotivationSegment = false;

  if ((currentEmotion == 1 && currentSegment >= 4) ||
      (currentEmotion == 2 && currentSegment >= 3) ||
      (currentEmotion == 3 && currentSegment >= 3) ||
      (currentEmotion == 4 && currentSegment >= 4)) {
    isMotivationSegment = true;
  }

  if (isMotivationSegment) {
    unsigned long currentMillis = millis();

    if (!isPlayingNote) {
      byte durationVal = pgm_read_byte(&(durations[noteIndex]));
      currentNoteDuration = 1000 / durationVal;
      noteStartTime = currentMillis;
      isPlayingNote = true;

      int noteVal = pgm_read_word(&(melody[noteIndex]));

      if (noteVal == REST) {
        noTone(BUZZER_PIN);
      } else {
        tone(BUZZER_PIN, noteVal);
      }
    }

    int totalNoteTime = currentNoteDuration * 1.30;
    if (currentMillis - noteStartTime >= totalNoteTime) {
      noTone(BUZZER_PIN);
      isPlayingNote = false;
      noteIndex++;

      if (noteIndex >= totalNotes) {
        return true;
      }
    }
  } else {
    noTone(BUZZER_PIN);
    noteIndex = 0;
    isPlayingNote = false;
  }

  return false;
}

void selectEmotion(int emotion) {
  digitalWrite(LED_PIN, HIGH);
  tone(BUZZER_PIN, 1000, 100);
  delay(100);
  digitalWrite(LED_PIN, LOW);

  currentEmotion = emotion;
  currentSegment = 0;
  noteIndex = 0;
  isPlayingNote = false;
  previousMillis = millis();
  
  updateLCD();
}

void resetToStandby() {
  currentEmotion = 0;
  currentSegment = 0;
  noteIndex = 0;
  isPlayingNote = false;
  noTone(BUZZER_PIN);
  standbyState = 0;
  standbyMillis = millis();
  displayStandby(0);

  // Isyarat wajib untuk Python mengetahui paparan motivasi & lagu sudah tamat
  Serial.println(F("DONE"));
}

