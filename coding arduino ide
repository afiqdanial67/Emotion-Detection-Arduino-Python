void displayStandby(int page) {
  lcd.clear();
  if (page == 0) {
    lcd.setCursor(0, 0); lcd.print(F(" EMOTION SELECT"));
    lcd.setCursor(0, 1); lcd.print(F("=waiting camera="));
  } 
  else if (page == 1) {
    float h = dht.readHumidity();
    float t = dht.readTemperature();

    if (isnan(h) || isnan(t)) {
      lcd.setCursor(0, 0); lcd.print(F("DHT11 Error!"));
      lcd.setCursor(0, 1); lcd.print(F("Check Wiring"));
    } else {
      lcd.setCursor(0, 0);
      lcd.print(F("Temp : "));
      lcd.print(t, 1);
      lcd.print((char)223); // Simbol °
      lcd.print(F("C"));

      lcd.setCursor(0, 1);
      lcd.print(F("Humid: "));
      lcd.print(h, 1);
      lcd.print(F("%"));
    }
  }
}
